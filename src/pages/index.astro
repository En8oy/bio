---
import { getImage } from "astro:assets";
import DesignLayout from "../layouts/DesignLayout.astro";
import "../components/dotfiles/dotfiles.css";
import profileSrc from "../assets/profile.jpg";

// "/" renders the default world (Dotfiles) directly — the same component
// /designs/dotfiles uses, not an iframe. An iframe-embedded page never
// paints anything of its own on the top-level frame Lighthouse measures,
// so "/" always scored NO_FCP even though the embedded page rendered fine.
// ?design=<slug> picks a different world via the client script below,
// which hands off to that world's own (already fast) page.
const VALID_DESIGNS = ["candy-brand", "terminal-dev", "neon", "dotfiles"];

const photo = await getImage({ src: profileSrc, width: 240, height: 240, format: "webp" });

const fontHref = "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap";
---

<DesignLayout
  title="Irbing Moreno — Full Stack + AI Engineer"
  fontHref={fontHref}
>
  <dotfiles-app photo-src={photo.src}></dotfiles-app>
</DesignLayout>

<script define:vars={{ VALID_DESIGNS }}>
  // Only redirects for a *non-default* ?design= — the default case needs
  // no navigation at all, since this page already is that world.
  const design = new URLSearchParams(window.location.search).get("design");
  if (design && design !== "dotfiles" && VALID_DESIGNS.includes(design)) {
    const forward = new URLSearchParams(window.location.search);
    forward.delete("design");
    const query = forward.toString();
    window.location.replace(`/designs/${design}${query ? `?${query}` : ""}`);
  }
</script>

<script>
  import "../components/dotfiles/dotfiles-app.ts";
</script>
