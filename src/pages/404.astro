---
import DesignLayout from "../layouts/DesignLayout.astro";

// Astro + GitHub Pages: a static build's 404.astro compiles to 404.html,
// which GitHub Pages automatically serves (with a real 404 status) for any
// unmatched path on this custom domain — no server config needed.
const REDIRECT_SECONDS = 5;
---

<DesignLayout
  title="404 — Irbing Moreno"
  description="Page not found."
  noindex
  bodyClass="nf-body"
>
  <main class="nf">
    <div class="nf-term">
      <div class="nf-term-bar">
        <span class="nf-dot nf-dot--red"></span>
        <span class="nf-dot nf-dot--amber"></span>
        <span class="nf-dot nf-dot--green"></span>
      </div>
      <div class="nf-term-body">
        <p class="nf-line"><span class="nf-prompt">$</span> cd <span class="nf-path" id="nf-path"></span></p>
        <p class="nf-line nf-error">bash: cd: <span class="nf-path" id="nf-path-2"></span>: No such file or directory</p>
        <p class="nf-line nf-code">404<span class="nf-cursor" aria-hidden="true"></span></p>
      </div>
    </div>

    <p class="nf-message" data-en="This page doesn't exist." data-es="Esta página no existe."></p>
    <p class="nf-redirect">
      <span data-en="Redirecting to the homepage in" data-es="Redirigiendo al inicio en"></span>{" "}
      <span class="nf-count" id="nf-count">{REDIRECT_SECONDS}</span>s…
    </p>
    <a class="nf-link" href="/" data-en="Go home now" data-es="Ir al inicio ahora"></a>
  </main>
</DesignLayout>

<style>
  .nf {
    min-height: calc(100vh - 80px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 120px 24px 64px;
    text-align: center;
    font-family: var(--font-sans);
    color: var(--color-text);
  }

  .nf-term {
    width: 100%;
    max-width: 480px;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    text-align: left;
  }

  .nf-term-bar {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .nf-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .nf-dot--red {
    background: #ff5f56;
  }

  .nf-dot--amber {
    background: #ffbd2e;
  }

  .nf-dot--green {
    background: #27c93f;
  }

  .nf-term-body {
    padding: 18px 20px 22px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .nf-line {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .nf-prompt {
    color: var(--color-accent, #00aa8a);
    font-weight: 700;
  }

  .nf-path {
    color: var(--color-text-muted);
  }

  .nf-error {
    color: var(--brand-danger, #ff4d4d);
  }

  .nf-code {
    margin-top: 10px;
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-accent, #00aa8a);
  }

  .nf-cursor {
    display: inline-block;
    width: 0.52em;
    height: 0.82em;
    margin-left: 4px;
    background: var(--color-accent, #00aa8a);
    animation: nf-blink 1s step-end infinite;
    vertical-align: -0.1em;
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-cursor {
      animation: none;
    }
  }

  @keyframes nf-blink {
    50% {
      opacity: 0;
    }
  }

  .nf-message {
    font-size: 1.05rem;
    color: var(--color-text);
    margin: 0;
  }

  .nf-redirect {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .nf-count {
    color: var(--color-accent, #00aa8a);
    font-weight: 700;
  }

  .nf-link {
    display: inline-flex;
    align-items: center;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-accent-contrast, #fff);
    background: var(--color-accent, #00aa8a);
    padding: 10px 18px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .nf-link:hover {
    opacity: 0.85;
  }
</style>

<script>
  import { getStoredLang, onLangChange, type Lang } from "../lib/i18n";

  const applyLang = (lang: Lang) => {
    document.querySelectorAll<HTMLElement>("[data-en]").forEach((el) => {
      el.textContent = (lang === "es" ? el.dataset.es : el.dataset.en) ?? "";
    });
  };

  let lang = getStoredLang();
  applyLang(lang);
  onLangChange((l) => {
    lang = l;
    applyLang(lang);
  });

  const path = window.location.pathname + window.location.search;
  document.getElementById("nf-path")!.textContent = path;
  document.getElementById("nf-path-2")!.textContent = path;

  const countEl = document.getElementById("nf-count")!;
  let remaining = Number(countEl.textContent);

  const timer = window.setInterval(() => {
    remaining -= 1;
    countEl.textContent = String(Math.max(remaining, 0));
    if (remaining <= 0) {
      window.clearInterval(timer);
      window.location.replace("/");
    }
  }, 1000);
</script>
